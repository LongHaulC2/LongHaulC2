[Unit]
Description=LongHaulC2 Backend Server
# Ensures the network is up before the listener tries to bind to a port
After=network.target

[Service]
Type=simple
User=longhaul
Group=longhaul

# Set working directory to the dynamically injected install path
WorkingDirectory=@INSTALL_DIR@

# Force Python to unbuffer stdout so logs stream to journalctl instantly
Environment=PYTHONUNBUFFERED=1
# load .env so we can access various .env values if needed. Can just use load_dotenv and os.genenv()
EnvironmentFile=@INSTALL_DIR@/.env
ExecStart=@INSTALL_DIR@/server/venv/bin/python -m server.src.server.main

Restart=always
RestartSec=5

# Logging: Pipe stdout/stderr directly to systemd's journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=longhaulc2-server

[Install]
WantedBy=multi-user.target