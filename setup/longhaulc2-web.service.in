[Unit]
Description=LongHaulC2 Web Client UI
After=network.target longhaulc2-server.service

[Service]
Type=simple
User=longhaul
Group=longhaul

WorkingDirectory=@INSTALL_DIR@/web

ExecStart=@INSTALL_DIR@/web/venv/bin/python -m client.src.client.main

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=longhaulc2-web

[Install]
WantedBy=multi-user.target